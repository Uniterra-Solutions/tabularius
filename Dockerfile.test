# Dockerfile.test — derived image for tabularius E2E testing.
#
# Base: official hermes-agent image (immutable /opt/hermes at runtime).
# Tabularius and its missing runtime deps (json-repair, fabricium) are
# installed at BUILD time, when the layer is root-writable. Runtime never
# pip-installs — see docs/testing.md and the hermes-plugin-testing skill.
FROM nousresearch/hermes-agent:latest

# Install tabularius + its deps into the immutable venv at build time.
# openai/pydantic/httpx are already present in the base image.
#
# The base image pins uv's `exclude-newer` to a build-date snapshot
# (2026-07-20), which hides packages published after that date — fabricium
# 0.3.0 (2026-07-28) would resolve as "only <=0.1.7 available". Override the
# snapshot so the repo's current dependencies resolve.
ENV UV_EXCLUDE_NEWER=2099-01-01
RUN uv pip install --python /opt/hermes/.venv/bin/python json-repair "fabricium>=0.3.0"

# Copy the repo and install the package itself (editable not needed — E2E
# exercises the installed package exactly as `pip install tabularius` would).
COPY . /src/tabularius
RUN uv pip install --python /opt/hermes/.venv/bin/python /src/tabularius

# Sanity: the import must resolve inside the venv.
RUN /opt/hermes/.venv/bin/python -c "import tabularius, fabricium, json_repair; print('deps ok')"
